# Brahms Nexus - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' with real secrets to GitHub!

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# IMPORTANT: NEVER expose your Supabase SERVICE_ROLE key in client apps or frontend code!
# The SERVICE_ROLE key bypasses all Row Level Security (RLS).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# RUNNING / BUILDING WITH SECURE DEFINES:
# Option 1 (Recommended for Local Dev & CI/CD):
#   flutter run --dart-define-from-file=.env
#
# Option 2 (Manual flags):
#   flutter run --dart-define=SUPABASE_URL=https://... --dart-define=SUPABASE_ANON_KEY=ey...
# -----------------------------------------------------------------------------
