rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Checks if the incoming request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user's document exists in the 'users' collection
    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Checks if the user is operating on their own document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Retrieves current user profile data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Checks if the authenticated user has the 'owner' or 'admin' role
    function isSystemOwner() {
      return isAuthenticated() && 
             ((userDocExists() && (getUserData().role == 'owner' || getUserData().role == 'admin')) || 
              request.auth.token.email == 'owner@brahmsnexus.internal');
    }

    // Checks if the user's account is active and approved by the owner
    function isApprovedStaff() {
      return isAuthenticated() && 
             (isSystemOwner() || (userDocExists() && getUserData().status == 'approved'));
    }

    // Validates string length for data sanity
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // Holds authentication mapping, roles, statuses, and staff details.
    // =========================================================================
    match /users/{userId} {
      // Owner and approved staff can read user lists; users can read their own profile
      allow read: if isOwner(userId) || isApprovedStaff();

      // Users can register as staff, or Owner can auto-seed/create user profiles
      allow create: if isOwner(userId) || isSystemOwner();

      // Profile updates:
      // - System owner can update any field (approvals, role changes, positions)
      // - Standard users can only update non-sensitive info (not role, status, etc.)
      allow update: if isSystemOwner() ||
                       (isOwner(userId) && 
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'status', 'createdAt', 'uid']));

      // Only the system owner can delete an account
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 2. PRODUCTION BATCHES & SESSIONS (Main Warehouse / Carne Inventory)
    // Supports Reseko module, mixed sizes (400g, 300g, 250g), cook boiling,
    // and cutter portioning workflow. Only Owner can delete batches.
    // =========================================================================
    match /production_batches/{batchId} {
      allow read, create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();

      match /{document=**} {
        allow read, create, update: if isSystemOwner() || isApprovedStaff();
        allow delete: if isSystemOwner();
      }
    }

    // =========================================================================
    // 3. MEAT PORTIONING REPORTS
    // Submitted by Production Meat Cutters upon completing portioning sessions.
    // =========================================================================
    match /portioning_reports/{reportId} {
      allow read, write: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 4. BRANCH MEAT INVENTORY (PCS)
    // Tracks current 250g Regular, 300g Medium, and 400g B1T1 stock per branch.
    // =========================================================================
    match /branch_meat_stocks/{branchId} {
      allow read, write: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 5. MEAT DISPATCHES
    // Warehouse dispatches to branches with real-time driver delivery status.
    // =========================================================================
    match /meat_dispatches/{dispatchId} {
      allow read, write: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 6. SUPPLY REQUESTS
    // Requests from branches/production staff for raw materials or supplies.
    // =========================================================================
    match /supply_requests/{requestId} {
      allow read, write: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 7. BILAO ORDERS
    // Advance bilao packages, scheduling, and delivery status tracking.
    // =========================================================================
    match /bilao_orders/{orderId} {
      allow read: if isApprovedStaff();
      allow create: if isSystemOwner();
      allow update: if isSystemOwner() ||
                       (isApprovedStaff() && 
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['totalPrice', 'commissionAmount', 'depositPaid', 'createdAt', 'customerName', 'customerPhone']));
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 8. DAILY BRANCH INVENTORY VERIFICATION
    // Document ID: ${branchId}_${YYYYMMDD}
    // =========================================================================
    match /branch_daily_inventories/{inventoryDocId} {
      allow read, write: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 9. DAILY SALES COLLECTION
    // End-of-day sales, portions sold, computed wage, and expected remittance.
    // =========================================================================
    match /daily_sales/{saleId} {
      allow read, create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 10. DAILY INCIDENT & SHORTAGE REPORTS
    // Operational issue reports (torn packs, gas shortage, equipment issues).
    // =========================================================================
    match /daily_reports/{reportId} {
      allow read, create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 11. ESP32 RFID ATTENDANCE LOGS
    // =========================================================================
    match /rfid_attendance/{tapId} {
      allow read, create: if isSystemOwner() || isApprovedStaff();
      allow update, delete: if isSystemOwner();
    }

    // =========================================================================
    // 12. REAL-TIME STAFF NOTIFICATIONS
    // Broadcast notifications and system alerts targeted to staff members.
    // =========================================================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 13. OWNER NOTIFICATIONS
    // Sent to Owner when cook completes boiling, cutter completes portioning,
    // or branch submits sales/inventory reports.
    // =========================================================================
    match /owner_notifications/{notifId} {
      allow read, update, delete: if isSystemOwner();
      allow create: if isApprovedStaff() || isSystemOwner();
    }

    // =========================================================================
    // 14. SETTINGS & APP CONFIGURATION
    // System-wide targets such as global portioning ratios and targets.
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isSystemOwner() || isApprovedStaff();
      allow write: if isSystemOwner();
    }

    // =========================================================================
    // 15. ANNOUNCEMENTS & DELETED ANNOUNCEMENTS
    // =========================================================================
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSystemOwner();
    }

    match /deleted_announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isSystemOwner();
    }

    // =========================================================================
    // 16. DEACTIVATED / FROZEN STAFF REGISTRY
    // Checked during login before full auth profile resolution.
    // =========================================================================
    match /deactivated_staff/{username} {
      allow read: if true;
      allow write: if isSystemOwner();
    }

    // =========================================================================
    // 17. STAFF ASSIGNMENTS & SCHEDULES
    // Managed by owner, readable by all authenticated team members.
    // =========================================================================
    match /staff_assignments/{username} {
      allow read: if isAuthenticated();
      allow write: if isSystemOwner();
    }

    // =========================================================================
    // 18. EMAIL OTPs
    // Temporary codes for account onboarding and password recovery.
    // =========================================================================
    match /email_otps/{email} {
      allow read, write: if true;
    }

    // =========================================================================
    // DEFAULT DENY RULE
    // Any collections not explicitly matched above are strictly locked down.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
