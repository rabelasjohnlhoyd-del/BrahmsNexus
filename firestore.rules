rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Checks if the incoming request is from a logged-in user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if user doc exists in the database
    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Checks if the user is operating on their own document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Retrieves user data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Checks if the authenticated user has the 'owner' role
    function isSystemOwner() {
      return isAuthenticated() && 
             ((userDocExists() && getUserData().role == 'owner') || 
              request.auth.token.email == 'owner@brahmsnexus.internal');
    }

    // Checks if the user's account has been verified and approved by the Owner
    function isApprovedStaff() {
      return isAuthenticated() && 
             (isSystemOwner() || (userDocExists() && getUserData().status == 'approved'));
    }

    // Validates string length to prevent resource exhaustion / DoS attacks
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // Holds authentication mapping, roles, and approval statuses.
    // =========================================================================
    match /users/{userId} {
      // Any authenticated user can read their own profile; Owner can read all profiles
      allow read: if isOwner(userId) || isSystemOwner();

      // Users can register as pending/approved staff, or Owner can auto-seed/create profiles
      allow create: if isOwner(userId) &&
                       (((request.resource.data.status == 'pending' || request.resource.data.status == 'approved') &&
                         request.resource.data.role == 'staff' &&
                         isValidString(request.resource.data.username, 3, 50)) ||
                        isSystemOwner());

      // Updates:
      // - Standard users can only update their non-sensitive fields (e.g. contactNumber)
      // - ONLY the system owner can approve/reject accounts or change roles
      allow update: if isSystemOwner() ||
                       (isOwner(userId) && 
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'status', 'createdAt', 'uid']));

      // Only the system owner can delete an account
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 2. BILAO ORDERS COLLECTION
    // Tracks advance bilao packages, scheduling, and live delivery status.
    // =========================================================================
    match /bilao_orders/{orderId} {
      // Approved staff (cooks & drivers) and owner can view active orders
      allow read: if isApprovedStaff();

      // Owner can create new confirmed bilao orders
      allow create: if isSystemOwner() &&
                       isValidString(request.resource.data.customerName, 2, 100) &&
                       request.resource.data.quantity is int &&
                       request.resource.data.quantity > 0;

      // Staff (Cooks/Drivers) can update operational statuses (prep, delivery, notes),
      // but CANNOT tamper with financial fields (price, deposit, commissions, customer name)
      allow update: if isSystemOwner() ||
                       (isApprovedStaff() && 
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['totalPrice', 'commissionAmount', 'depositPaid', 'createdAt', 'customerName', 'customerPhone']));

      // Only Owner can delete an order
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 3. DAILY BRANCH INVENTORY VERIFICATION
    // Document ID is formatted as: ${branchId}_${YYYYMMDD}
    // =========================================================================
    match /branch_daily_inventories/{inventoryDocId} {
      // Approved staff and owner can view today's allocated/verified stock
      allow read: if isSystemOwner() || isApprovedStaff();

      // Owner allocates stock; Approved staff (cook/driver) can create or update
      // their branch's verification record (actualReceived, status fields)
      allow create, update: if isSystemOwner() || isApprovedStaff();

      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 4. DAILY SALES COLLECTION
    // End-of-day sales, portions sold, computed wage, and expected remittance.
    // =========================================================================
    match /daily_sales/{saleId} {
      // Owner can read all sales records; Approved staff can read their branch sales
      allow read: if isSystemOwner() || isApprovedStaff();

      // Approved cook can submit their daily sales report
      allow create, update: if isApprovedStaff() || isSystemOwner();

      // Historical sales records cannot be deleted after submission (tamper protection)
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 5. DAILY INCIDENT & SHORTAGE REPORTS
    // =========================================================================
    match /daily_reports/{reportId} {
      allow read: if isSystemOwner() || isApprovedStaff();

      // Approved staff can report operational issues (mayo torn, gas empty)
      allow create: if isApprovedStaff() &&
                       isValidString(request.resource.data.content, 1, 1000);

      // Owner / Admin can update (e.g. quick reply, status change)
      allow update: if isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 6. ESP32 RFID ATTENDANCE LOGS
    // =========================================================================
    match /rfid_attendance/{tapId} {
      allow read: if isSystemOwner() || isApprovedStaff();

      // Logged taps from approved staff or dedicated hardware reader
      allow create: if isApprovedStaff() &&
                       isValidString(request.resource.data.rfidTag, 3, 64) &&
                       request.resource.data.timestamp != null;

      // Attendance records are immutable (audit trail integrity)
      allow update, delete: if isSystemOwner();
    }

    // =========================================================================
    // 7. REAL-TIME NOTIFICATIONS
    // =========================================================================
    match /notifications/{notifId} {
      // Staff can read broadcast notifications ('all') or targeted to them
      allow read: if isAuthenticated();

      // Owner or approved staff submitting reports/sales can dispatch alerts or mark them as read
      allow create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 8. PRODUCTION BATCHES & SESSIONS (Main Warehouse Inventory)
    // Tracks carne batches, portioning sessions, boiling, and yield metrics.
    // =========================================================================
    match /production_batches/{batchId} {
      allow read: if isSystemOwner() || isApprovedStaff();
      allow create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();

      match /{document=**} {
        allow read, write: if isSystemOwner() || isApprovedStaff();
      }
    }

    // =========================================================================
    // 9. DEACTIVATED / FROZEN STAFF REGISTRY
    // Keyed by lowercase username to freeze staff accounts instantly upon login.
    // =========================================================================
    match /deactivated_staff/{username} {
      // Read stays open — app checks this on login before auth role is established
      allow read: if true;
      // Only owner can freeze/unfreeze staff accounts
      allow write: if isSystemOwner();
    }

    // =========================================================================
    // 10. ANNOUNCEMENTS
    // Broadcast notices shown to all active staff members.
    // =========================================================================
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSystemOwner();
    }

    // =========================================================================
    // 11. STAFF ASSIGNMENTS & SCHEDULES
    // Daily rest day and duty status assignments managed by the Owner.
    // =========================================================================
    match /staff_assignments/{username} {
      // Any authenticated user can read assignments (staff sees coworkers, owner sees all)
      allow read: if isAuthenticated();
      // Only owner can create/edit/delete assignments
      allow write: if isSystemOwner();
    }

    // =========================================================================
    // 12. BRANCH MEAT INVENTORY (PCS)
    // Tracks 250g Regular, 300g Medium, and 400g B1T1 stock per branch.
    // =========================================================================
    match /branch_meat_stocks/{branchId} {
      // Approved staff can read stock levels for their branch; owner reads all
      allow read: if isSystemOwner() || isApprovedStaff();
      // Owner manages baseline allocation; approved staff (cook) can update stock counts
      allow create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 13. MEAT DISPATCHES
    // Real-time dispatches from Main Warehouse to branches with Driver delivery updates.
    // =========================================================================
    match /meat_dispatches/{dispatchId} {
      // All approved staff (cook, driver, owner) can read dispatch records
      allow read: if isSystemOwner() || isApprovedStaff();
      // Owner creates dispatch orders; approved staff (driver) can update delivery status
      allow create, update: if isSystemOwner() || isApprovedStaff();
      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // 14. OWNER NOTIFICATIONS
    // Written by approved staff (sales submit, inventory verify) — read by owner.
    // =========================================================================
    match /owner_notifications/{notifId} {
      // Owner (and Admin) can read all notifications
      allow read: if isSystemOwner();

      // Approved staff (cooks) can create notifications when they submit sales/inventory
      allow create: if isApprovedStaff();

      // Owner can mark as read (update isRead field)
      allow update: if isSystemOwner();

      allow delete: if isSystemOwner();
    }

    // =========================================================================
    // DEFAULT DENY RULE
    // Any collections not explicitly matched above are strictly locked down.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
